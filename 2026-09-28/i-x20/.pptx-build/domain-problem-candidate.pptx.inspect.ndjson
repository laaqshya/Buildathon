{"kind":"textbox","id":"sh/2x4fedwr","slide":1,"text":"Incomplete place names and phrases such as “tomorrow evening” must be resolved before retrieving data.","textPreview":"Incomplete place names and phrases such as “tomorrow evening” must be resolved before retrieving data.","textChars":102,"textLines":1,"bbox":[542,616,210,68]}
