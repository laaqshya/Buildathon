{"kind":"textbox","id":"sh/s72d83ep","slide":1,"text":"AGENT DECISION\nRELIABILITY","textPreview":"AGENT DECISION | RELIABILITY","textChars":26,"textLines":2,"bbox":[302,574,210,38]}
{"kind":"textbox","id":"sh/t8be18fa","slide":1,"text":"The agent must select the correct tools, interpret results accurately and avoid generating unsupported weather information.","textPreview":"The agent must select the correct tools, interpret results accurately and avoid generating unsupported weather information.","textChars":123,"textLines":1,"bbox":[302,616,210,68]}
{"kind":"shape","id":"sh/i10v29gn","slide":1,"bbox":[529,546,1,137]}
